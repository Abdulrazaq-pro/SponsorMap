# All integrations are optional. With none set, SponsorMap runs in demo mode:
# records live in the browser, extraction uses the built-in rule-based parser.

# Amazon Bedrock (commitment extraction, evidence review, report narrative)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Amazon S3 (agreements + evidence)
S3_AGREEMENTS_BUCKET=
S3_EVIDENCE_BUCKET=

# PostgreSQL (sponsorship records)
DATABASE_URL=postgres://sponsormap:sponsormap@localhost:5432/sponsormap

# HubSpot (demo requests -> contacts/deals)
HUBSPOT_PRIVATE_APP_TOKEN=
